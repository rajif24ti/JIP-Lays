<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNamaPeralatan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nama Peralatan"
                android:textColor="@color/primary_navy"
                android:textSize="16sp"
                android:fontFamily="@font/montserrat_bold" />

            <TextView
                android:id="@+id/tvPrioritasBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/soft_blue"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="Tinggi"
                android:textColor="@color/primary_blue"
                android:textSize="11sp"
                android:fontFamily="@font/montserrat_medium" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLokasiTanggal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Lokasi: Divisi Memasak | 01 Nov 2026"
            android:textColor="@color/text_body"
            android:textSize="12sp"
            android:fontFamily="@font/inter_18pt_regular" />

        <TextView
            android:id="@+id/tvDeskripsi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Deskripsi singkat kendala atau kerusakan peralatan dapur."
            android:textColor="@color/text_body"
            android:textSize="13sp" />

        <!-- ImageView loaded with Glide -->
        <ImageView
            android:id="@+id/imgBuktiFoto"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_marginTop="10dp"
            android:contentDescription="Bukti Foto Kerusakan"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailItem"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:text="Lihat Detail"
            android:textSize="11sp"
            android:fontFamily="@font/montserrat_medium"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/primary_blue" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
