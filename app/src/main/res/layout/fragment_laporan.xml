<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA">

    <!-- Header -->
    <TextView
        android:id="@+id/tvHeaderLaporan"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="@color/primary_navy"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:text="Laporan Operasional"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:fontFamily="@font/montserrat_bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Konten -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderLaporan"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ringkasan Laporan"
                android:textColor="@color/primary_navy"
                android:textSize="20sp"
                android:fontFamily="@font/montserrat_bold" />

            <TextView
                android:id="@+id/tvTanggalLaporan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Tanggal laporan"
                android:textColor="@color/text_body"
                android:textSize="14sp"
                android:fontFamily="@font/inter_18pt_regular" />

            <!-- Ringkasan total porsi -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/primary_navy"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Porsi Produksi"
                        android:textColor="@color/primary_light"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvLaporanPorsi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="2.000"
                        android:textColor="@color/white"
                        android:textSize="32sp"
                        android:fontFamily="@font/montserrat_bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Porsi pada laporan contoh"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Statistik lainnya -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvLaporanKaryawan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8"
                            android:textColor="@color/primary_blue"
                            android:textSize="26sp"
                            android:fontFamily="@font/montserrat_bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Karyawan"
                            android:textColor="@color/text_body"
                            android:textSize="12sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="105dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tvLaporanSekolah"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5"
                            android:textColor="@color/primary_blue"
                            android:textSize="26sp"
                            android:fontFamily="@font/montserrat_bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Sekolah Tujuan"
                            android:textColor="@color/text_body"
                            android:textSize="12sp" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Daftar laporan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Jenis Laporan"
                android:textColor="@color/primary_navy"
                android:textSize="18sp"
                android:fontFamily="@font/montserrat_bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Pilih laporan untuk melihat informasi operasional dapur."
                android:textColor="@color/text_body"
                android:textSize="13sp"
                android:fontFamily="@font/inter_18pt_regular" />

            <!-- Laporan Produksi -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#DFE6EF"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imgLaporanProduksi"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_dashboard"
                        android:contentDescription="Ikon laporan produksi"
                        android:padding="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvJudulProduksi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Laporan Produksi"
                        android:textColor="@color/primary_navy"
                        android:textSize="15sp"
                        android:fontFamily="@font/montserrat_bold"
                        app:layout_constraintStart_toEndOf="@id/imgLaporanProduksi"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/imgLaporanProduksi" />

                    <TextView
                        android:id="@+id/tvDeskripsiProduksi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="5dp"
                        android:text="Rekap jumlah porsi dan status produksi makanan."
                        android:textColor="@color/text_body"
                        android:textSize="12sp"
                        app:layout_constraintStart_toEndOf="@id/imgLaporanProduksi"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvJudulProduksi" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailProduksi"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginTop="12dp"
                        android:text="Lihat Detail"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        app:layout_constraintTop_toBottomOf="@id/imgLaporanProduksi"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Laporan Absensi -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#DFE6EF"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imgLaporanAbsensi"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_karyawan"
                        android:contentDescription="Ikon laporan absensi"
                        android:padding="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvJudulAbsensi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Laporan Kehadiran Karyawan"
                        android:textColor="@color/primary_navy"
                        android:textSize="15sp"
                        android:fontFamily="@font/montserrat_bold"
                        app:layout_constraintStart_toEndOf="@id/imgLaporanAbsensi"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/imgLaporanAbsensi" />

                    <TextView
                        android:id="@+id/tvDeskripsiAbsensi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="5dp"
                        android:text="Rekap kehadiran dan absensi karyawan dapur."
                        android:textColor="@color/text_body"
                        android:textSize="12sp"
                        app:layout_constraintStart_toEndOf="@id/imgLaporanAbsensi"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvJudulAbsensi" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailAbsensi"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginTop="12dp"
                        android:text="Lihat Detail"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        app:layout_constraintTop_toBottomOf="@id/imgLaporanAbsensi"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Laporan Distribusi -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:strokeColor="#DFE6EF"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/imgLaporanDistribusi"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:src="@drawable/ic_laporan"
                        android:contentDescription="Ikon laporan distribusi"
                        android:padding="8dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvJudulDistribusi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Laporan Distribusi"
                        android:textColor="@color/primary_navy"
                        android:textSize="15sp"
                        android:fontFamily="@font/montserrat_bold"
                        app:layout_constraintStart_toEndOf="@id/imgLaporanDistribusi"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/imgLaporanDistribusi" />

                    <TextView
                        android:id="@+id/tvDeskripsiDistribusi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="5dp"
                        android:text="Rekap penyaluran makanan ke sekolah tujuan."
                        android:textColor="@color/text_body"
                        android:textSize="12sp"
                        app:layout_constraintStart_toEndOf="@id/imgLaporanDistribusi"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tvJudulDistribusi" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDetailDistribusi"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginTop="12dp"
                        android:text="Lihat Detail"
                        android:textSize="12sp"
                        app:cornerRadius="10dp"
                        app:layout_constraintTop_toBottomOf="@id/imgLaporanDistribusi"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Catatan -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:text="Laporan operasional SIMOD MBG"
                android:textColor="#8795A8"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
