<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FB"
    tools:context=".AbsensiActivity">

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_toolbar_gradient"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Kembali"
            app:tint="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Absensi Karyawan"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="@font/montserrat_bold"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- TANGGAL -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTanggal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:strokeColor="#E1E8F0"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="76dp"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvLabelTanggal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TANGGAL ABSENSI"
                android:textColor="#8390A0"
                android:textSize="10sp"
                android:fontFamily="@font/montserrat_medium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/tvTanggal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Senin, 12 Oktober 2026"
                android:textColor="@color/primary_navy"
                android:textSize="13sp"
                android:fontFamily="@font/montserrat_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/imgCalendar"
                app:layout_constraintTop_toBottomOf="@id/tvLabelTanggal"/>

            <ImageView
                android:id="@+id/imgCalendar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:padding="9dp"
                android:src="@drawable/ic_dashboard"
                android:background="@drawable/bg_avatar"
                android:contentDescription="Tanggal absensi"
                app:tint="@color/primary_blue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- RINGKASAN HADIR -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHadir"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="6dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:strokeColor="#E1E8F0"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/cardTanggal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardPerhatian">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_18pt_regular"
                android:text="Hadir"
                android:textColor="#758397"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/montserrat_bold"
                android:text="2 orang"
                android:textColor="@color/status_success"
                android:textSize="17sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- RINGKASAN PERHATIAN -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPerhatian"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:strokeColor="#E1E8F0"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/cardTanggal"
        app:layout_constraintStart_toEndOf="@id/cardHadir"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Perlu perhatian"
                android:textColor="#758397"
                android:textSize="11sp"
                android:fontFamily="@font/inter_18pt_regular"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="2 orang"
                android:textColor="@color/status_warning"
                android:textSize="17sp"
                android:fontFamily="@font/montserrat_bold"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- TAB MASUK / PULANG -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tabContainer"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="14dp"
        android:background="#E6ECF4"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/cardHadir"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tabMasuk"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="@drawable/bg_button_gradient"
            android:text="Absen Masuk"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:fontFamily="@font/montserrat_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tabPulang"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tabPulang"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Absen Pulang"
            android:textColor="#718096"
            android:textSize="12sp"
            android:fontFamily="@font/montserrat_medium"
            app:layout_constraintStart_toEndOf="@id/tabMasuk"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- JUDUL DAFTAR -->
    <TextView
        android:id="@+id/tvDaftar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Daftar Karyawan"
        android:textColor="@color/primary_navy"
        android:textSize="15sp"
        android:fontFamily="@font/montserrat_bold"
        app:layout_constraintTop_toBottomOf="@id/tabContainer"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvJumlahKaryawan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:text="4 karyawan"
        android:textColor="#8390A0"
        android:textSize="11sp"
        android:fontFamily="@font/inter_18pt_regular"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/tvDaftar"/>

    <!-- DAFTAR KARYAWAN -->
    <ScrollView
        android:id="@+id/scrollKaryawan"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp"
        android:fillViewport="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvDaftar"
        app:layout_constraintBottom_toTopOf="@id/btnSimpan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp">

            <!-- SITI RAHAYU -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="9dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="#E1E8F0"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/avatarSiti"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:background="@drawable/bg_avatar"
                        android:text="SR"
                        android:textColor="@color/primary_blue"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat_bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/tvSiti"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Siti Rahayu"
                        android:textColor="@color/primary_navy"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat_bold"
                        app:layout_constraintStart_toEndOf="@id/avatarSiti"
                        app:layout_constraintEnd_toStartOf="@id/statusSiti"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/roleSiti"
                        app:layout_constraintVertical_chainStyle="packed"/>

                    <TextView
                        android:id="@+id/roleSiti"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Juru Masak"
                        android:textColor="#8390A0"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter_18pt_regular"
                        app:layout_constraintStart_toEndOf="@id/avatarSiti"
                        app:layout_constraintEnd_toStartOf="@id/statusSiti"
                        app:layout_constraintTop_toBottomOf="@id/tvSiti"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/statusSiti"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#E4F6EB"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="6dp"
                        android:text="Hadir"
                        android:textColor="#21834B"
                        android:textSize="10sp"
                        android:fontFamily="@font/montserrat_medium"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- AHMAD HIDAYAT -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="9dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="#E1E8F0"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/avatarAhmad"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:background="@drawable/bg_avatar"
                        android:text="AH"
                        android:textColor="@color/primary_blue"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat_bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/tvAhmad"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Ahmad Hidayat"
                        android:textColor="@color/primary_navy"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat_bold"
                        app:layout_constraintStart_toEndOf="@id/avatarAhmad"
                        app:layout_constraintEnd_toStartOf="@id/statusAhmad"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/roleAhmad"
                        app:layout_constraintVertical_chainStyle="packed"/>

                    <TextView
                        android:id="@+id/roleAhmad"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Asisten Masak"
                        android:textColor="#8390A0"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter_18pt_regular"
                        app:layout_constraintStart_toEndOf="@id/avatarAhmad"
                        app:layout_constraintEnd_toStartOf="@id/statusAhmad"
                        app:layout_constraintTop_toBottomOf="@id/tvAhmad"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/statusAhmad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#E4F6EB"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="6dp"
                        android:text="Hadir"
                        android:textColor="#21834B"
                        android:textSize="10sp"
                        android:fontFamily="@font/montserrat_medium"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- DEWI LESTARI -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="9dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="#E1E8F0"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/avatarDewi"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:background="@drawable/bg_avatar"
                        android:text="DL"
                        android:textColor="@color/primary_blue"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat_bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/tvDewi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Dewi Lestari"
                        android:textColor="@color/primary_navy"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat_bold"
                        app:layout_constraintStart_toEndOf="@id/avatarDewi"
                        app:layout_constraintEnd_toStartOf="@id/statusDewi"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/roleDewi"
                        app:layout_constraintVertical_chainStyle="packed"/>

                    <TextView
                        android:id="@+id/roleDewi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Packaging"
                        android:textColor="#8390A0"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter_18pt_regular"
                        app:layout_constraintStart_toEndOf="@id/avatarDewi"
                        app:layout_constraintEnd_toStartOf="@id/statusDewi"
                        app:layout_constraintTop_toBottomOf="@id/tvDewi"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/statusDewi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#FFF2D9"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="6dp"
                        android:text="Terlambat"
                        android:textColor="#A66A00"
                        android:textSize="10sp"
                        android:fontFamily="@font/montserrat_medium"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BAMBANG -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginBottom="9dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:strokeColor="#E1E8F0"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:id="@+id/avatarBambang"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:gravity="center"
                        android:background="@drawable/bg_avatar"
                        android:text="BS"
                        android:textColor="@color/primary_blue"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat_bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/tvBambang"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Bambang S."
                        android:textColor="@color/primary_navy"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat_bold"
                        app:layout_constraintStart_toEndOf="@id/avatarBambang"
                        app:layout_constraintEnd_toStartOf="@id/statusBambang"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/roleBambang"
                        app:layout_constraintVertical_chainStyle="packed"/>

                    <TextView
                        android:id="@+id/roleBambang"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Driver"
                        android:textColor="#8390A0"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter_18pt_regular"
                        app:layout_constraintStart_toEndOf="@id/avatarBambang"
                        app:layout_constraintEnd_toStartOf="@id/statusBambang"
                        app:layout_constraintTop_toBottomOf="@id/tvBambang"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                    <TextView
                        android:id="@+id/statusBambang"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#EEF1F5"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="6dp"
                        android:text="Belum Absen"
                        android:textColor="#667085"
                        android:textSize="10sp"
                        android:fontFamily="@font/montserrat_medium"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- TOMBOL TAMBAH ABSENSI -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSimpan"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_button_gradient"
        android:fontFamily="@font/montserrat_medium"
        android:text="+ Tambah Absensi"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:backgroundTint="@null"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- BOTTOM NAVIGATION -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/white"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/navBeranda"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/navKaryawan"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_home"
                app:tint="#8793A3"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Beranda"
                android:textColor="#8793A3"
                android:textSize="10sp"
                android:fontFamily="@font/inter_18pt_regular"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navKaryawan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintStart_toEndOf="@id/navBeranda"
            app:layout_constraintEnd_toStartOf="@id/navLaporan"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_karyawan"
                app:tint="@color/primary_blue"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Karyawan"
                android:textColor="@color/primary_blue"
                android:textSize="10sp"
                android:fontFamily="@font/montserrat_medium"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navLaporan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintStart_toEndOf="@id/navKaryawan"
            app:layout_constraintEnd_toStartOf="@id/navProfil"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_dashboard"
                app:tint="#8793A3"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Laporan"
                android:textColor="#8793A3"
                android:textSize="10sp"
                android:fontFamily="@font/inter_18pt_regular"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfil"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintStart_toEndOf="@id/navLaporan"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:src="@drawable/ic_person"
                app:tint="#8793A3"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Profil"
                android:textColor="#8793A3"
                android:textSize="10sp"
                android:fontFamily="@font/inter_18pt_regular"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
