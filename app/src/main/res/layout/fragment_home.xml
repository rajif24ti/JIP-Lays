<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FA"
    tools:context=".HomeFragment">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:background="@color/primary_navy"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIMOD MBG"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:fontFamily="@font/montserrat_bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Beranda Operasional Dapur"
                android:textColor="#D9E6F7"
                android:textSize="11sp"
                android:fontFamily="@font/inter_18pt_regular"/>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Logout"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:fontFamily="@font/montserrat_medium"
            app:backgroundTint="#D93036"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_person"
            app:iconTint="@color/white"
            app:iconPadding="4dp"/>

    </LinearLayout>

    <!-- Konten Home -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollHome"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Sambutan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selamat datang,"
                android:textColor="@color/text_body"
                android:textSize="13sp"
                android:fontFamily="@font/inter_18pt_regular"/>

            <TextView
                android:id="@+id/tvWelcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Penanggung Jawab Dapur"
                android:textColor="@color/primary_navy"
                android:textSize="20sp"
                android:fontFamily="@font/montserrat_bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Pantau aktivitas dapur hari ini"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:fontFamily="@font/inter_18pt_regular"/>

            <!-- Ringkasan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Ringkasan Hari Ini"
                android:textColor="@color/primary_navy"
                android:textSize="17sp"
                android:fontFamily="@font/montserrat_bold"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:columnCount="2"
                android:rowCount="2"
                android:useDefaultMargins="false">

                <!-- Produksi -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#DFE6EF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Produksi Hari Ini"
                            android:textColor="#64748B"
                            android:textSize="11sp"/>

                        <TextView
                            android:id="@+id/tvProduksi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="12 batch"
                            android:textColor="@color/primary_blue"
                            android:textSize="20sp"
                            android:fontFamily="@font/montserrat_bold"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Karyawan -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#DFE6EF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Karyawan Hadir"
                            android:textColor="#64748B"
                            android:textSize="11sp"/>

                        <TextView
                            android:id="@+id/tvKaryawan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="28/30"
                            android:textColor="@color/primary_blue"
                            android:textSize="20sp"
                            android:fontFamily="@font/montserrat_bold"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sekolah Penerima -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="5dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#DFE6EF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sekolah Penerima"
                            android:textColor="#64748B"
                            android:textSize="11sp"/>

                        <TextView
                            android:id="@+id/tvSekolah"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="8 sekolah"
                            android:textColor="@color/primary_blue"
                            android:textSize="20sp"
                            android:fontFamily="@font/montserrat_bold"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Total Porsi -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="104dp"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="5dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#DFE6EF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Total Porsi"
                            android:textColor="#64748B"
                            android:textSize="11sp"/>

                        <TextView
                            android:id="@+id/tvPorsi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="2.480"
                            android:textColor="@color/primary_blue"
                            android:textSize="20sp"
                            android:fontFamily="@font/montserrat_bold"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- Aktivitas Terbaru -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Aktivitas Terbaru"
                android:textColor="@color/primary_navy"
                android:textSize="17sp"
                android:fontFamily="@font/montserrat_bold"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#DFE6EF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Produksi selesai · Batch 4"
                        android:textColor="@color/primary_navy"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat_medium"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="320 porsi nasi ayam teriyaki"
                        android:textColor="#64748B"
                        android:textSize="11sp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#E7ECF2"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Absensi masuk · Siti Rahayu"
                        android:textColor="@color/primary_navy"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat_medium"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Posisi: Juru Masak"
                        android:textColor="#64748B"
                        android:textSize="11sp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#E7ECF2"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kotak saran baru masuk"
                        android:textColor="@color/primary_navy"
                        android:textSize="13sp"
                        android:fontFamily="@font/montserrat_medium"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Masukan dari sekolah penerima"
                        android:textColor="#64748B"
                        android:textSize="11sp"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Menu Cepat -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Menu Cepat"
                android:textColor="@color/primary_navy"
                android:textSize="17sp"
                android:fontFamily="@font/montserrat_bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAbsensi"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#DFE6EF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_karyawan"
                            android:contentDescription="Ikon absensi"
                            app:tint="@color/primary_blue"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Absensi"
                            android:textColor="@color/primary_navy"
                            android:textSize="12sp"
                            android:fontFamily="@font/montserrat_medium"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGizi"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#DFE6EF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_gizi"
                            android:contentDescription="Ikon gizi"
                            app:tint="@color/primary_blue"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Gizi"
                            android:textColor="@color/primary_navy"
                            android:textSize="12sp"
                            android:fontFamily="@font/montserrat_medium"/>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
