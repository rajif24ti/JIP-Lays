<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:contentDescription="Logo JIP-Lays"
            android:scaleType="centerInside"
            android:src="@drawable/logo_apk" />

        <!-- JUDUL -->
        <TextView
            android:id="@+id/tvRegisterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Buat Akun Baru"
            android:textColor="@color/primary_navy"
            android:textSize="20sp" />

        <!-- SUBJUDUL -->
        <TextView
            android:id="@+id/tvRegisterSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/inter_18pt_regular"
            android:text="Lengkapi data untuk mendaftar ke JIP-Lays"
            android:textColor="@color/text_body"
            android:textSize="11sp" />

        <!-- NAMA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="NAMA LENGKAP"
            android:textColor="@color/primary_navy"
            android:textSize="9sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="7dp"
            app:boxCornerRadiusBottomStart="7dp"
            app:boxCornerRadiusTopEnd="7dp"
            app:boxCornerRadiusTopStart="7dp"
            app:boxStrokeColor="@color/primary_light"
            app:boxStrokeWidth="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNama"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/inter_18pt_regular"
                android:hint="Masukkan nama lengkap"
                android:inputType="textPersonName"
                android:paddingStart="13dp"
                android:textColor="@color/text_body"
                android:textSize="12sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- NOMOR HANDPHONE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="NOMOR HANDPHONE"
            android:textColor="@color/primary_navy"
            android:textSize="9sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="7dp"
            app:boxCornerRadiusBottomStart="7dp"
            app:boxCornerRadiusTopEnd="7dp"
            app:boxCornerRadiusTopStart="7dp"
            app:boxStrokeColor="@color/primary_light"
            app:boxStrokeWidth="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etHandphone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/inter_18pt_regular"
                android:hint="Contoh: 081234567890"
                android:inputType="phone"
                android:paddingStart="13dp"
                android:textColor="@color/text_body"
                android:textSize="12sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- USERNAME -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="USERNAME"
            android:textColor="@color/primary_navy"
            android:textSize="9sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="7dp"
            app:boxCornerRadiusBottomStart="7dp"
            app:boxCornerRadiusTopEnd="7dp"
            app:boxCornerRadiusTopStart="7dp"
            app:boxStrokeColor="@color/primary_light"
            app:boxStrokeWidth="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/inter_18pt_regular"
                android:hint="Buat username"
                android:inputType="text"
                android:paddingStart="13dp"
                android:textColor="@color/text_body"
                android:textSize="12sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- PASSWORD -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="PASSWORD"
            android:textColor="@color/primary_navy"
            android:textSize="9sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="7dp"
            app:boxCornerRadiusBottomStart="7dp"
            app:boxCornerRadiusTopEnd="7dp"
            app:boxCornerRadiusTopStart="7dp"
            app:boxStrokeColor="@color/primary_light"
            app:boxStrokeWidth="0dp"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/inter_18pt_regular"
                android:hint="Buat password"
                android:inputType="textPassword"
                android:paddingStart="13dp"
                android:textColor="@color/text_body"
                android:textSize="12sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ROLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="ROLE"
            android:textColor="@color/primary_navy"
            android:textSize="9sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRole"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="7dp"
            app:boxCornerRadiusBottomStart="7dp"
            app:boxCornerRadiusTopEnd="7dp"
            app:boxCornerRadiusTopStart="7dp"
            app:boxStrokeWidth="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRole"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/inter_18pt_regular"
                android:hint="Masukkan role"
                android:inputType="textCapWords"
                android:paddingStart="13dp"
                android:textSize="12sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- TOMBOL DAFTAR -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_button_gradient"
            android:fontFamily="@font/montserrat_medium"
            android:text="Daftar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:backgroundTint="@null"
            app:cornerRadius="7dp" />

        <!-- KEMBALI KE LOGIN -->
        <TextView
            android:id="@+id/tvBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:padding="8dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Sudah punya akun? Masuk"
            android:textColor="@color/primary_blue"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
