<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detail Kandungan Gizi Menu"
            android:textColor="@color/primary_navy"
            android:textSize="17sp"
            android:fontFamily="@font/montserrat_bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pilih menu produksi untuk melihat rincian nutrisi dari Supabase."
            android:textColor="@color/text_body"
            android:textSize="12sp" />

        <!-- Menu Selector Dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:hintEnabled="false">

            <AutoCompleteTextView
                android:id="@+id/actPilihMenuGizi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Pilih Menu Produksi"
                android:inputType="none"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Menu Detail Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGiziDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    app:cardBackgroundColor="@color/soft_blue"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/imgGiziPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Gambar Menu Gizi"
                        android:scaleType="centerCrop"
                        android:src="@drawable/lays" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvGiziMenuTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Nama Menu Produksi"
                    android:textColor="@color/primary_navy"
                    android:textSize="18sp"
                    android:fontFamily="@font/montserrat_bold" />

                <TextView
                    android:id="@+id/tvGiziMenuTanggal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tanggal: — • Total: 0 Porsi"
                    android:textColor="@color/primary_blue"
                    android:textSize="12sp"
                    android:fontFamily="@font/montserrat_medium" />

                <TextView
                    android:id="@+id/tvGiziSekolah"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Sekolah tujuan"
                    android:textColor="@color/text_body"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="12dp"
                    android:background="@color/border" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rincian Kandungan Nutrisi (per Porsi):"
                    android:textColor="@color/primary_navy"
                    android:textSize="13sp"
                    android:fontFamily="@font/montserrat_bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvGiziEnergi"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/soft_blue"
                        android:padding="10dp"
                        android:text="Energi:\n—"
                        android:textColor="@color/primary_navy"
                        android:textSize="12sp"
                        android:fontFamily="@font/montserrat_medium" />

                    <TextView
                        android:id="@+id/tvGiziProtein"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@color/soft_blue"
                        android:padding="10dp"
                        android:text="Protein:\n—"
                        android:textColor="@color/primary_navy"
                        android:textSize="12sp"
                        android:fontFamily="@font/montserrat_medium" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvGiziKarbo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/soft_blue"
                        android:padding="10dp"
                        android:text="Karbohidrat:\n—"
                        android:textColor="@color/primary_navy"
                        android:textSize="12sp"
                        android:fontFamily="@font/montserrat_medium" />

                    <TextView
                        android:id="@+id/tvGiziLemak"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@color/soft_blue"
                        android:padding="10dp"
                        android:text="Lemak:\n—"
                        android:textColor="@color/primary_navy"
                        android:textSize="12sp"
                        android:fontFamily="@font/montserrat_medium" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvGiziSerat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@color/soft_blue"
                        android:padding="10dp"
                        android:text="Serat:\n—"
                        android:textColor="@color/primary_navy"
                        android:textSize="12sp"
                        android:fontFamily="@font/montserrat_medium" />

                    <TextView
                        android:id="@+id/tvGiziKalsium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@color/soft_blue"
                        android:padding="10dp"
                        android:text="Kalsium:\n—"
                        android:textColor="@color/primary_navy"
                        android:textSize="12sp"
                        android:fontFamily="@font/montserrat_medium" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvGiziZatBesi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/soft_blue"
                    android:padding="10dp"
                    android:text="Zat Besi: —"
                    android:textColor="@color/primary_navy"
                    android:textSize="12sp"
                    android:fontFamily="@font/montserrat_medium" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
