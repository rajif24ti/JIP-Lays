<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Header -->
    <TextView
        android:id="@+id/tvHeaderProduksi"
        android:layout_width="0dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_header_wave"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:text="Produksi Makanan MBG"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- MODUL 11: TabLayout & ViewPager2 -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutProduksi"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@color/white"
        app:tabIndicatorColor="@color/primary_blue"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="@color/primary_blue"
        app:tabTextColor="@color/text_body"
        app:tabMode="fixed"
        app:layout_constraintTop_toBottomOf="@id/tvHeaderProduksi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerProduksi"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabLayoutProduksi"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
