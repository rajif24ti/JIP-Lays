<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Logo -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="135dp"
        android:layout_height="135dp"
        android:src="@drawable/logo_apk"
        android:contentDescription="Logo SIMOD MBG"
        android:scaleType="centerInside"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="65dp" />

    <!-- Nama aplikasi -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SIMOD MBG"
        android:textSize="30sp"
        android:textColor="@color/primary_blue"
        android:fontFamily="@font/momotrustdisplay_regular"
        app:layout_constraintTop_toBottomOf="@id/imgLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Deskripsi -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sistem Informasi Manajemen Operasional Dapur MBG"
        android:textSize="13sp"
        android:textColor="@color/text_body"
        android:fontFamily="@font/inter_18pt_regular"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvAppName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="45dp"
        android:layout_marginEnd="45dp"
        android:layout_marginTop="8dp" />

    <!-- ========================= -->
    <!-- Tombol Login -->
    <!-- ========================= -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="LOGIN"
        android:textSize="15sp"
        android:textColor="@color/white"
        android:fontFamily="@font/montserrat_medium"
        android:background="@drawable/bg_button_gradient"
        app:backgroundTint="@null"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="30dp" />

    <!-- ========================= -->
    <!-- Tombol Aplikasi -->
    <!-- ========================= -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAplikasi"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="APLIKASI"
        android:textSize="15sp"
        android:textColor="@color/primary_blue"
        android:fontFamily="@font/montserrat_medium"
        app:backgroundTint="@color/primary_light"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnLogin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="14dp" />

    <!-- ========================= -->
    <!-- Tombol Website -->
    <!-- ========================= -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWebView"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="WEBSITE MBG"
        android:textSize="15sp"
        android:textColor="@color/white"
        android:fontFamily="@font/montserrat_medium"
        app:backgroundTint="@color/primary_navy"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnAplikasi"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="14dp" />

</androidx.constraintlayout.widget.ConstraintLayout>