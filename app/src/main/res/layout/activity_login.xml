<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="40dp"
        android:paddingBottom="30dp">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="105dp"
            android:layout_height="105dp"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:contentDescription="Logo SIMOD MBG"
            android:scaleType="centerInside"
            android:src="@drawable/logo_apk" />

        <!-- JUDUL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Masuk ke akun Anda"
            android:textColor="@color/primary_navy"
            android:textSize="20sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/inter_18pt_regular"
            android:text="Gunakan kredensial pengelola dapur Anda"
            android:textColor="@color/text_body"
            android:textSize="11sp" />

        <!-- USERNAME -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="USERNAME"
            android:textColor="@color/primary_navy"
            android:textSize="9sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="7dp"
            app:boxCornerRadiusBottomStart="7dp"
            app:boxCornerRadiusTopEnd="7dp"
            app:boxCornerRadiusTopStart="7dp"
            app:boxStrokeColor="@color/primary_light"
            app:boxStrokeWidth="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/inter_18pt_regular"
                android:hint="admin"
                android:inputType="text"
                android:paddingStart="13dp"
                android:textSize="12sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- PASSWORD -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="PASSWORD"
            android:textColor="@color/primary_navy"
            android:textSize="9sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="7dp"
            app:boxCornerRadiusBottomStart="7dp"
            app:boxCornerRadiusTopEnd="7dp"
            app:boxCornerRadiusTopStart="7dp"
            app:boxStrokeColor="@color/primary_light"
            app:boxStrokeWidth="0dp"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/inter_18pt_regular"
                android:inputType="textPassword"
                android:paddingStart="13dp"
                android:textSize="12sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ROLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Masuk sebagai:"
            android:textColor="@color/text_body"
            android:textSize="9sp" />

        <AutoCompleteTextView
            android:id="@+id/actRole"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:fontFamily="@font/inter_18pt_regular"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Penanggung Jawab Dapur"
            android:textColor="@color/text_body"
            android:textSize="10sp" />

        <!-- BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:layout_marginTop="9dp"
            android:background="@drawable/bg_button_gradient"
            android:fontFamily="@font/montserrat_medium"
            android:text="Masuk"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            app:backgroundTint="@null"
            app:cornerRadius="7dp" />

    </LinearLayout>

</ScrollView>